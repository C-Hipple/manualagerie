# Required
OPENROUTER_API_KEY=sk-or-...
APP_PASSWORD=change-me

# Optional
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_METADATA_MODEL=        # defaults to OPENROUTER_MODEL
# SECRET_KEY=                       # auto-generated into /data/secret_key if unset
# APP_URL=https://manuals.example.com
# DATA_DIR=/data
# MAX_UPLOAD_MB=100
# OCR_LANGS=eng
# PREFERRED_LANGS=en
# STRIP_OTHER_LANGS=true           # drop paragraphs in other languages at ingest (reindex to apply)
# BACKUP_KEEP=7
# SEMANTIC_SEARCH=true             # hybrid keyword + local-embedding search; false = keyword (FTS) only
# LLM_TOOLS=true                    # false = non-agentic retrieve-then-answer pipeline
# AUTH_DISABLED=false               # local development only
