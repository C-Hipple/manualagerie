# Required
OPENROUTER_API_KEY=sk-or-...
APP_PASSWORD=change-me

# Optional
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_METADATA_MODEL=        # defaults to OPENROUTER_MODEL
# SECRET_KEY=                       # auto-generated into /data/secret_key if unset
# APP_URL=https://manuals.example.com   # public base URL: Secure cookies and share links
# DATA_DIR=/data
# MAX_UPLOAD_MB=100
# OCR_LANGS=eng
# VISION_OCR=fallback               # off | fallback | always: let the LLM read scanned pages and diagrams
# OPENROUTER_VISION_MODEL=          # must accept image input; defaults to OPENROUTER_METADATA_MODEL, then OPENROUTER_MODEL
# VISION_CONCURRENCY=2              # vision requests in flight at once per manual
# PREFERRED_LANGS=en
# STRIP_OTHER_LANGS=true           # drop paragraphs in other languages at ingest (reindex to apply)
# BACKUP_KEEP=7
# LLM_TOOLS=true                    # false = non-agentic retrieve-then-answer pipeline
# CHAT_IMAGES=true                  # attach photos/screenshots to chat questions (model must accept images)
# AUTH_DISABLED=false               # local development only
